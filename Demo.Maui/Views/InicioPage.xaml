<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:helpers="clr-namespace:Demo.Maui.Helpers"
             xmlns:viewmodels="clr-namespace:Demo.Maui.ViewModels"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Demo.Maui.Views.InicioPage"
             x:DataType="viewmodels:InicioViewModel"
             Title="InicioPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:ConvertidorBooleanoInverso x:Key="ConvertidorBooleanoInverso" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid IsVisible="{Binding EstaCargando, Converter={StaticResource ConvertidorBooleanoInverso}}"
              Padding="0,20,0,0"
              RowDefinitions="Auto,*"
              RowSpacing="0">

            <VerticalStackLayout Grid.Row="0"
                                 HorizontalOptions="Center"
                                 Spacing="10"
                                 WidthRequest="370">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout>
                        <Label Text="Saldo disponible" TextColor="{StaticResource Gray900}" FontFamily="OpenSansRegular" FontSize="18" />
                        <Label Text="{Binding Saldo}" FontFamily="OpenSansSemibold" FontSize="24" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1" Command="{Binding MenuInicioCommand}" BackgroundColor="{StaticResource PrimaryDark}" HorizontalOptions="End" VerticalOptions="Center" Text="☰" TextColor="Black" FontSize="20" />
                </Grid>

                <Grid ColumnDefinitions="9*,11*" ColumnSpacing="10">
                    <Button Command="{Binding AliasCvuCommand}" Text="Ver Alias y CVU" TextColor="White" FontAttributes="Bold" FontSize="16" BackgroundColor="{StaticResource Primary}" />
                    <Button Grid.Column="1" Text="Métodos de pago" TextColor="White" FontAttributes="Bold" FontSize="16" BackgroundColor="{StaticResource VerdePersonalizado}" />
                </Grid>
            </VerticalStackLayout>

            <Grid Grid.Row="1" RowDefinitions="*">
                <VerticalStackLayout Padding="0,8,0,0"
                                    HorizontalOptions="Center"
                                    Spacing="15"
                                    VerticalOptions="Center"
                                    WidthRequest="340"
                                    MaximumWidthRequest="400">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="15" WidthRequest="340">
                        <VerticalStackLayout>
                            <Button Command="{Binding CrearCocheraCommand}" IsVisible="{Binding TieneCocheras, Converter={StaticResource ConvertidorBooleanoInverso}}" Text="Soy dueño y quiero comenzar" TextColor="White" FontAttributes="Bold" FontSize="16" CornerRadius="5" HeightRequest="80" />
                            <Button Command="{Binding AdministrarCocherasCommand}" IsVisible="{Binding TieneCocheras}" Text="Administrar mis cocheras" TextColor="White" FontAttributes="Bold" FontSize="16" CornerRadius="5" HeightRequest="80" />
                        </VerticalStackLayout>
                        <Button Grid.Row="1" Command="{Binding MapaCommand}" Text="Buscar cocheras en el mapa" TextColor="White" FontAttributes="Bold" FontSize="16" CornerRadius="5" HeightRequest="80" BackgroundColor="{StaticResource VerdePersonalizado}" />
                        <Button Grid.Row="2" Command="{Binding VerReservasCommand}" Text="Historial de reservas" TextColor="White" FontAttributes="Bold" FontSize="16" CornerRadius="5" HeightRequest="80" BackgroundColor="#EA8C0C" />
                        <Button Grid.Row="3" Command="{Binding VerCalificacionesCommand}" Text="Puntuaciones recibidas" TextColor="White" FontAttributes="Bold" FontSize="16" CornerRadius="5" HeightRequest="80" BackgroundColor="#EF4444" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <Grid IsVisible="{Binding EstaCargando}">
            <VerticalStackLayout VerticalOptions="Center" Spacing="15">
                <VerticalStackLayout Spacing="5">
                    <ActivityIndicator IsRunning="{Binding EstaCargando}" HeightRequest="50" WidthRequest="50" />
                    <Label Text="Cargando" TextColor="{StaticResource NegroSuave}" Style="{StaticResource H4Center}" />
                </VerticalStackLayout>
                <Label Text="Aguarde un momento por favor" TextColor="{StaticResource GrisAcero}" Style="{StaticResource Text16Center}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
